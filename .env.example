# Copy this file to ".env" (gitignored) and fill in real values.
# docker-compose reads it to inject secrets into the backend container.

# Anthropic API key (answer generation)
ANTHROPIC_API_KEY=sk-ant-...

# AWS credentials (S3 uploads + Bedrock embeddings)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-north-1
